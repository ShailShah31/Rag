# Optional shell template. The CLI does not automatically load .env.
REPO_RAG_DB_DIR=.repo-rag/chroma
REPO_RAG_CHUNK_LINES=60
REPO_RAG_OVERLAP_LINES=10
REPO_RAG_MAX_FILE_BYTES=262144
REPO_RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
REPO_RAG_EMBEDDING_REVISION=
REPO_RAG_TOP_K=5
REPO_RAG_MAX_DISTANCE=0.75
REPO_RAG_CONTEXT_CHARS=20000
REPO_RAG_MAX_TOKENS=900
REPO_RAG_API_TIMEOUT=30
REPO_RAG_API_RETRIES=2

# Required for generation only. Set a Messages API model ID enabled for you.
ANTHROPIC_MODEL=
ANTHROPIC_API_KEY=
